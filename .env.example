# Copy this file to .env and set values for your machine.
# All variables are optional — if unset, paths default to subfolders of the project root.

# Absolute path to the project root (default: directory containing config.py)
# PROJECT_ROOT=/path/to/ISI-MasterDegreeThesis

# Absolute path to the data folder containing prepared_data.pt and output .pt files
# DATA_DIR=/path/to/data

# Absolute path to where Optuna SQLite DB and other results are saved
# RESULTS_DIR=/path/to/results
